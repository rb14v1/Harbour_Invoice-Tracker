# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres) ---
POSTGRES_DB=invoice_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production only (config.settings.prod) ---
# In prod, DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS and
# all POSTGRES_* variables are REQUIRED (startup fails if unset).
# Optional, defaults to True when unset:
# SECURE_SSL_REDIRECT=

# --- API / auth tuning (optional; uncomment to override the defaults) ---
# API_PAGE_SIZE=                        # default 20
# AUTH_THROTTLE_RATE=                   # default 20/min
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=    # default 15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=      # default 7

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
